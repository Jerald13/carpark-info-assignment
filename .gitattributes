# Normalise line endings so diffs stay clean across Windows/macOS/Linux checkouts.
* text=auto eol=lf

*.sln       text eol=crlf
*.csproj    text eol=lf
*.props     text eol=lf
*.cs        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.ps1       text eol=crlf
*.sh        text eol=lf

*.csv       text eol=lf
*.png       binary
*.jpg       binary
*.pdf       binary
*.db        binary
