<Project>

  <!--
    Central Package Management: every package version is declared exactly once, here.
    A Version= attribute on a PackageReference in any .csproj is a defect - see SKILLS.md 7.11.

    All versions verified against the NuGet v3 API on 2026-07-31. See PLAN.md section 0.2.

    DELIBERATELY ABSENT (PLAN.md 0.3, ADR-011 / ADR-013):
      FluentAssertions - v8+ is a commercial Xceed product. Use AwesomeAssertions (Apache-2.0).
      AutoMapper       - commercial since 2025-04-16. Use hand-written mappers.
      MediatR          - commercial. Use cases resolve directly through DI.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Data access">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="File ingestion">
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>

  <ItemGroup Label="API surface">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="FluentValidation" Version="11.3.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.3.1" />
  </ItemGroup>

  <ItemGroup Label="Transitive security pins">
    <!--
      SECURITY PIN. Microsoft.AspNetCore.OpenApi 10.0.10 resolves Microsoft.OpenApi 2.0.0
      transitively, which carries a HIGH severity advisory:

        GHSA-v5pm-xwqc-g5wc - "Circular schema references may terminate OpenAPI parsing"
        vulnerable: >= 2.0.0-preview.11, <= 2.7.4   patched: 2.7.5

      Pinned to the latest 2.x rather than 3.x to stay inside the major version that
      Microsoft.AspNetCore.OpenApi 10.0.10 was compiled against. Caught at restore by
      CentralPackageTransitivePinningEnabled + TreatWarningsAsErrors (NU1903).

      REVIEW when Microsoft.AspNetCore.OpenApi ships a build that resolves a patched
      version itself - this pin can then be deleted.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />

    <!--
      SECURITY PIN. Microsoft.EntityFrameworkCore.Sqlite 10.0.10 resolves
      SQLitePCLRaw.lib.e_sqlite3 2.1.11 transitively, which bundles a SQLite build carrying a
      HIGH severity advisory:

        GHSA-2m69-gcr7-jv3q - "SQLitePCLRaw.lib.e_sqlite3 has a vulnerable dependency on SQLite"
        vulnerable: <= 2.1.11

      2.1.12 is the first release outside that range and stays on the same line as the
      SQLitePCLRaw.bundle_e_sqlite3 that EF Core resolves, so the native assets remain compatible.
      Jumping to 3.x would cross a major boundary EF Core 10 was not built against.

      REVIEW when EF Core ships a build that resolves a patched version itself.
    -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup Label="Cross-cutting">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.5.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
  </ItemGroup>

</Project>
